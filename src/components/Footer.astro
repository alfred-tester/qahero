---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<footer class="footer">
  <div class="container">
    <div class="rule-thick-h"></div>

    <div class="footer-content">
      <div class="footer-section brand-section">
        <a href={baseUrl} class="footer-logo">QA HERO</a>
        <p class="footer-description">
          Registrando la evolución de la calidad de software, metodologías de
          automatización, y patrones de desarrollo con rigor periodístico y
          técnico.
        </p>
      </div>

      <div class="footer-section links-section">
        <h4 class="label-caps section-title">Contenido</h4>
        <ul class="footer-links">
          <li><a href={baseUrl}>Inicio</a></li>
          <li><a href={`${baseUrl}blog`}>Artículos</a></li>
          <li><a href={`${baseUrl}colaborar`}>Colaborar</a></li>
        </ul>
      </div>

      <div class="footer-section links-section">
        <h4 class="label-caps section-title">Conexiones</h4>
        <ul class="footer-links">
          <li>
            <a
              href="https://github.com/alfred-tester"
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="click-github"
              >GitHub</a
            >
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/alfredtejeda/"
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="click-linkedin"
              >LinkedIn</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="rule-thin-h"></div>

    <div class="footer-bottom label-caps">
      <span>© 2026 QA HERO. Todos los derechos reservados.</span>
      <span class="status-indicator">
        <span class="status-dot"></span>
        SISTEMAS OPERATIVOS // PASADO
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background-color: var(--color-background);
    padding-top: var(--section-gap);
    padding-bottom: var(--grid-margin);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--grid-gutter);
    padding: 3rem 0;
  }

  .brand-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 450px;
  }

  .footer-logo {
    font-family: var(--font-editorial);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }

  .footer-description {
    font-family: var(--font-functional);
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .section-title {
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    display: block;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-family: var(--font-functional);
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    border-bottom: 1px solid transparent;
  }

  .footer-links a:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0 0 0;
    color: var(--color-on-surface-variant);
    font-size: 0.75rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-on-tertiary-container); /* Cyber Green from style */
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-on-tertiary-container);
    display: inline-block;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0.3;
    }
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 0;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
