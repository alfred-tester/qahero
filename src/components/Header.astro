---
const today = new Date().toLocaleDateString("es-ES", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="header">
  <div class="container masthead">
    <div class="masthead-top">
      <div class="masthead-col col-left label-caps">EST. 2026 // VOL. I</div>
      <div class="masthead-center">
        <a href={baseUrl} class="masthead-title">QAHERO</a>
        <div class="masthead-tagline">
          EL DIARIO DE ASEGURAMIENTO DE CALIDAD Y DESARROLLO
        </div>
      </div>
      <div class="masthead-col col-right label-caps">EDICIÓN DIGITAL</div>
    </div>

    <div class="rule-thin-h"></div>

    <div class="masthead-meta label-caps">
      <span>SECCIÓN: DESARROLLO Y PRUEBAS</span>
      <span>{today.toUpperCase()}</span>
      <span>ESTADO: VERIFICADO</span>
    </div>

    <div class="rule-thick-h"></div>

    <nav class="nav-bar">
      <a href={baseUrl} class="nav-link label-caps">Inicio</a>
      <span class="nav-separator">//</span>
      <a href={`${baseUrl}blog`} class="nav-link label-caps">Artículos</a>
      <span class="nav-separator">//</span>
      <a href={`${baseUrl}colaborar`} class="nav-link label-caps">Colaborar</a>
    </nav>

    <div class="rule-thin-h"></div>
  </div>
</header>

<style>
  .header {
    width: 100%;
    background-color: var(--color-background);
  }

  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--grid-gutter);
    padding-bottom: 0;
  }

  .masthead-top {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
  }

  .masthead-col {
    width: 25%;
    font-family: var(--font-technical);
    color: var(--color-on-surface-variant);
  }

  .col-left {
    text-align: left;
  }

  .col-right {
    text-align: right;
  }

  .masthead-center {
    width: 50%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .masthead-title {
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-primary);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .masthead-title:hover {
    transform: scale(0.99);
  }

  .masthead-tagline {
    font-family: var(--font-functional);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .masthead-meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    color: var(--color-primary);
    font-size: 0.75rem;
  }

  .nav-bar {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 0;
  }

  .nav-link {
    font-family: var(--font-technical);
    font-size: 0.875rem;
    padding: 0.35rem 0.75rem;
    color: var(--color-primary);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .nav-separator {
    font-family: var(--font-technical);
    color: var(--color-outline-variant);
    font-weight: bold;
    user-select: none;
  }

  @media (max-width: 768px) {
    .masthead-col {
      display: none;
    }

    .masthead-center {
      width: 100%;
    }

    .masthead-meta {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      padding: 0.75rem 0;
    }
  }
</style>
